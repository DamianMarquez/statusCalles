# Backend Fastify: configurarlo en el entorno de Node.js de Plesk.
NODE_ENV=production
BACKEND_HOST=0.0.0.0
# Plesk normalmente asigna PORT; BACKEND_PORT es el fallback local.
BACKEND_PORT=3000

# PostgreSQL/PostGIS. Reemplazar con la URL real; nunca subir credenciales.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Origen exacto donde se publica el frontend, sin ruta ni barra final.
CORS_ORIGIN=https://pozometro.com.ar

# Opcionales: proxy confiable y límites de conexiones PostgreSQL.
TRUST_PROXY=
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000

# Opcionales: el backend tiene valores predeterminados si se omiten.
USIG_ADDRESS_SEARCH_URL=https://servicios.usig.buenosaires.gob.ar/normalizar/
ADDRESS_SEARCH_MIN_QUERY_LENGTH=3

# URLs opcionales para importar datasets oficiales de CABA.
CABA_STREETS_URL=https://data.buenosaires.gob.ar/dataset/calles/resource/2941f731-0a2e-4391-b8c9-a2912a80c081/download
CABA_NEIGHBORHOODS_URL=https://data.buenosaires.gob.ar/dataset/barrios/resource/1c3d185b-fdc9-474b-b41b-9bd960a3806e/download
CABA_COMMUNES_URL=https://data.buenosaires.gob.ar/dataset/comunas/resource/b0b627ac-5b47-4574-89ac-6999b63598ee/download
CABA_CICLOVIAS_URL=https://data.buenosaires.gob.ar/dataset/ciclovias/resource/9119760a-a35a-4808-ac04-1fc0f668edaa/download
CABA_METROBUS_URL=https://data.buenosaires.gob.ar/dataset/metrobus/resource/ae8e105d-4899-4ff7-b06a-cf3485dae99d/download
CABA_METROBUS_STOPS_URL=https://data.buenosaires.gob.ar/dataset/metrobus/resource/13f6872a-f726-4094-b426-bc55d7b63efe/download

# Límites por minuto. Valores iniciales recomendados.
RATE_LIMIT_REPORTS_MAX=20
RATE_LIMIT_FEEDBACK_MAX=30
RATE_LIMIT_FLAGS_MAX=5
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REPORT_STATUS_MAX=10
RATE_LIMIT_ANALYTICS_MAX=60
RATE_LIMIT_ROUTING_MAX=20
RATE_LIMIT_ADDRESS_SEARCH_MAX=30
RATE_LIMIT_ROAD_INFORMATION_MAX=15
RATE_LIMIT_REPORTS_WINDOW_SECONDS=60
RATE_LIMIT_FEEDBACK_WINDOW_SECONDS=60
RATE_LIMIT_FLAGS_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
RATE_LIMIT_REPORT_STATUS_WINDOW_SECONDS=60
RATE_LIMIT_ANALYTICS_WINDOW_SECONDS=60
RATE_LIMIT_ROUTING_WINDOW_SECONDS=60
RATE_LIMIT_ADDRESS_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_ROAD_INFORMATION_WINDOW_SECONDS=60

# Solo para ejecutar tests de integración localmente; usar una base separada.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE?sslmode=require
