{
  "name": "@street-status/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.17.0 || ^22.9.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:status": "tsx src/infrastructure/database/migration-status-cli.ts",
    "import:caba:streets": "tsx src/infrastructure/external/caba/import-cli.ts streets",
    "import:caba:neighborhoods": "tsx src/infrastructure/external/caba/import-cli.ts neighborhoods",
    "import:caba:communes": "tsx src/infrastructure/external/caba/import-cli.ts communes",
    "import:caba:all": "tsx src/infrastructure/external/caba/import-cli.ts all",
    "sync:caba:ciclovias": "tsx src/infrastructure/external/caba/mobility-import-cli.ts ciclovias",
    "sync:caba:metrobus": "tsx src/infrastructure/external/caba/mobility-import-cli.ts metrobus",
    "sync:caba:metrobus-stops": "tsx src/infrastructure/external/caba/mobility-import-cli.ts metrobusStops",
    "sync:caba:infrastructure": "tsx src/infrastructure/external/caba/mobility-import-cli.ts all"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
