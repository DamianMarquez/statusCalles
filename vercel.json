{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "entrypoint": "api/[...path].ts",
      "installCommand": "cd .. && npm ci --include=dev",
      "buildCommand": "cd .. && npm run build --workspace backend"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "cd .. && npm ci --include=dev",
      "buildCommand": "cd .. && npm run build --workspace frontend",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/((?!assets/).*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
