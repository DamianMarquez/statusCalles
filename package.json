{
  "name": "street-status",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:migrate:status": "npm run db:migrate:status --workspace backend",
    "import:caba:streets": "npm run import:caba:streets --workspace backend",
    "import:caba:neighborhoods": "npm run import:caba:neighborhoods --workspace backend",
    "import:caba:communes": "npm run import:caba:communes --workspace backend",
    "import:caba:all": "npm run import:caba:all --workspace backend",
    "sync:caba:ciclovias": "npm run sync:caba:ciclovias --workspace backend",
    "sync:caba:metrobus": "npm run sync:caba:metrobus --workspace backend",
    "sync:caba:metrobus-stops": "npm run sync:caba:metrobus-stops --workspace backend",
    "sync:caba:infrastructure": "npm run sync:caba:infrastructure --workspace backend",
    "routing:setup": "bash scripts/setup-routing.sh",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.29.0"
  },
  "type": "module"
}
